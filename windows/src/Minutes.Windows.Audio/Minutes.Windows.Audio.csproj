<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows-only by construction: this is the WASAPI interop. It does not
         build on macOS, which is why every piece of logic worth testing lives in
         Minutes.Core instead. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Minutes.Core/Minutes.Core.csproj" />
  </ItemGroup>
</Project>
